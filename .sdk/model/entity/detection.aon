# Entity: detection

main: kit: entity: detection: {

  alias: field: {}

  fields: [
    {
      name: "details"
      req: false
      short: "Additional information about the detection"
      type: "`$STRING`"
    }
    {
      name: "indicators"
      req: false
      short: "List of phishing indicators detected"
      type: "`$ARRAY`"
    }
    {
      name: "isPhishing"
      req: false
      short: "Whether the URL is identified as phishing"
      type: "`$BOOLEAN`"
    }
    {
      name: "recommendation"
      req: false
      short: "Recommended action based on the scan results"
      type: "`$STRING`"
    }
    {
      name: "resource"
      req: false
      short: "The scanned resource (URL or domain)"
      type: "`$STRING`"
    }
    {
      name: "scanId"
      req: false
      short: "Unique identifier for the scan"
      type: "`$STRING`"
    }
    {
      name: "score"
      req: false
      short: "Confidence score of the detection (0-100)"
      type: "`$NUMBER`"
    }
    {
      name: "threatLevel"
      req: false
      short: "The severity level of the threat"
      type: "`$STRING`"
    }
    {
      format: "date-time"
      name: "timestamp"
      req: false
      short: "When the scan was performed"
      type: "`$STRING`"
    }
    {
      format: "uri"
      name: "url"
      op: {
        create: {
          req: true
          type: "`$STRING`"
        }
      }
      req: false
      short: "The analyzed URL"
      type: "`$STRING`"
    }
  ]

  name: "detection"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/check"
          segments: [
            {
              lit: "check"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                kind: "query"
                name: "domain"
                orig: "domain"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "scan_id"
                orig: "scan_id"
                reqd: false
                type: "`$STRING`"
              }
              {
                kind: "query"
                name: "url"
                orig: "url"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/scan"
          segments: [
            {
              lit: "scan"
            }
          ]
          select: {
            exist: [
              "domain"
              "scan_id"
              "url"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.indicators`"
          }
        }
      ]
    }
  }



}
